<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/ColorSecundario"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="8dp"
                    android:text="Categorias"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:layout_weight="1"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/ivSaveCategory"
                    android:layout_width="185dp"
                    android:layout_height="45dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@color/white"
                    app:tint="#FF0000"
                    android:text="Agregar Categoria"
                    android:backgroundTint="@color/color_primario"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@drawable/backgroun_et"
                    android:hint="Ingresar una nueva categoria"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/black"
                    android:textColorHint="#C7C7C7" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                android:background="#5B000000"
                android:paddingVertical="5dp"
                >

                <ImageButton
                    android:id="@+id/color1"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color1" />

                <ImageButton
                    android:id="@+id/color2"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color2" />

                <ImageButton
                    android:id="@+id/color3"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color3" />

                <ImageButton
                    android:id="@+id/color4"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color4" />

                <ImageButton
                    android:id="@+id/color5"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color5" />

                <ImageButton
                    android:id="@+id/color6"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color6" />

                <ImageButton
                    android:id="@+id/color7"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color7" />

                <ImageButton
                    android:id="@+id/color8"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/selector_color"
                    android:backgroundTint="@color/color8" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sv_categorias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/items_categorias">

                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>