<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:backgroundTint="#303030"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                android:text="Categorias"
                android:textColor="@color/white"
                android:textSize="24dp"
                />
            <LinearLayout
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textColor="@color/black"
                    android:background="@drawable/backgroun_et"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColorHint="#C7C7C7"
                    android:hint="Ingresar una nueva categoria"
                    android:layout_weight="2"
                    />
                <ImageView
                    android:id="@+id/ivSaveCategory"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/plus"
                    app:tint="#FF0000" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                >
                <Button
                    android:id="@+id/color1"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"
                    />
                <Button
                    android:id="@+id/color2"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"

                    />
                <Button
                    android:id="@+id/color3"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"

                    />
                <Button
                    android:id="@+id/color4"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"

                    />
                <Button
                    android:id="@+id/color5"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"

                    />
                <Button
                    android:id="@+id/color6"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"
                    />
                <Button
                    android:id="@+id/color7"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp"
                    />
                <Button
                    android:id="@+id/color8"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/selector_color"
                    android:layout_marginHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:padding="12dp"
                >
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sv_categorias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/items_categorias"
                    >

                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>